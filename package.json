  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "hls",
    "m3u8",
    "stream-downloader",
    "concurrency",
    "rfc8216",
    "video-segments",
    "nodejs"
  ],
